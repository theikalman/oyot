{
  "name": "oyot",
  "version": "0.0.12-alpha",
  "description": "A local-first note-taking app that syncs directly between your own devices.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "format": "prettier --write .",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "dependencies": {
